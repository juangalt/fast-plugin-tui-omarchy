#!/bin/bash

# oma-quick-plugin-tui — browse, search, sort and install Omarchy marketplace
# plugins from a fzf TUI, in the style of omarchy-pkg-aur-install.
#
# Data comes from two JSON endpoints published by the marketplace:
#   catalog.json  — plugin metadata incl. category, tags, GitHub stars
#   /v1/stats     — hearts / views / copies per plugin id
# Both are cached under $XDG_CACHE_HOME/oma-quick-plugin-tui and joined once by
# jq into a TSV that fzf reloads instantly on every sort/filter change.
#
# fzf key bindings re-invoke this script with a `__subcommand` (see dispatch at
# the bottom), so the whole tool is one file with no extra dependencies beyond
# curl, jq, fzf and gum — all shipped with Omarchy.

set -euo pipefail

SELF=$(realpath -- "${BASH_SOURCE[0]}")
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oma-quick-plugin-tui"
CATALOG_URL="${OMA_QUICK_PLUGIN_TUI_CATALOG_URL:-https://plugins.omarchy.org/catalog.json}"
STATS_URL="${OMA_QUICK_PLUGIN_TUI_STATS_URL:-https://api.omarchyplugins.com/v1/stats}"
CATALOG_TTL_MIN=360
STATS_TTL_MIN=15
PLUGINS_DIR="$HOME/.config/omarchy/plugins"
SORTS=(stars hearts views copies added updated name)
DRY_RUN="${OMA_QUICK_PLUGIN_TUI_DRY_RUN:-0}"
ASSUME_YES="${OMA_QUICK_PLUGIN_TUI_YES:-0}"
STATE_FILE="${OPT_STATE:-$CACHE_DIR/state}"
state_dir="${OPT_STATE_DIR-}"   # per-run private dir (state file, fzf socket); set in main()

SORT=stars
CATEGORY=""
ONLY_INSTALLED=0
ONLY_VERIFIED=0
HL_FIELD=""   # header field that just changed (SORT, CATEGORY, ONLY_*) …
HL_UNTIL=0    # … shown highlighted until this epoch-millisecond deadline
HL_MS=1200

# Nerd Font glyphs (star, heart, eye, copy) — the same font foot renders.
G_STAR=$''
G_HEART=$''
G_VIEWS=$''
G_COPIES=$''

fail() {
  echo "oma-quick-plugin-tui: $*" >&2
  exit 1
}

# Catalog data is untrusted: ids are only accepted in this shape (they are
# used as awk needles and as omarchy plugin arguments), and any string that
# reaches the terminal is stripped of control characters first so a crafted
# entry cannot inject escape sequences into the preview or the action output.
ID_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'
valid_id() { [[ $1 =~ $ID_RE && $1 != *..* ]]; }
sanitize() { printf '%s' "${1//[[:cntrl:]]/}"; }

# "Oma Quick Plugin TUI - v0.1": major.minor from the manifest next to the script.
title() {
  local v
  v=$(jq -r '.version // empty' "$(dirname -- "$SELF")/../manifest.json" 2>/dev/null) || v=""
  if [[ $v =~ ^([0-9]+\.[0-9]+) ]]; then v=${BASH_REMATCH[1]}; else v=0.1; fi
  printf 'Oma Quick Plugin TUI - v%s\n' "$v"
}

# Programs that own the tty while fzf waits on an execute() — gum 2.0 above
# all — query the terminal (DECRQM 2026/2027, kitty keyboard flags, …) and
# the replies ("ESC[?2026;2$y", "ESC[?1u", …) can still be queued on the tty
# when they exit. fzf would then read them as keystrokes: each `?` opens the
# help popup and the rest lands in the query. Drop whatever is queued before
# handing the terminal back. Call it at the end of every path that runs
# something interactive on the tty, and before fzf starts.
drain_tty() {
  : 2>/dev/null <>/dev/tty || return 0
  while read -rsn 1 -t 0.1 _ </dev/tty; do :; done
  return 0
}

usage() {
  cat <<USAGE
Usage: oma-quick-plugin-tui [--refresh] [--yes] [--dry-run] [-h]

  --refresh   re-download the catalog and stats before starting
  --yes       pass --yes to omarchy plugin add/remove/update (skips confirmations)
  --dry-run   print the omarchy commands instead of running them

Environment: OMA_QUICK_PLUGIN_TUI_YES=1, OMA_QUICK_PLUGIN_TUI_DRY_RUN=1
             OMA_QUICK_PLUGIN_TUI_CATALOG_URL, OMA_QUICK_PLUGIN_TUI_STATS_URL (any curl URL, e.g. file://…)
Cache: $CACHE_DIR
USAGE
}

# ---------------------------------------------------------------- cache ---

cache_fresh() {
  local file="$CACHE_DIR/$1" minutes="$2"
  [[ -f $file && -n $(find "$file" -mmin -"$minutes" 2>/dev/null) ]]
}

# Download to a temp file in the cache dir, validate it is JSON with a
# .plugins key, then rename atomically so a failed download never clobbers
# the copy we already have. gum draws the spinner on stderr, which under
# fzf's execute() is whatever fzf inherited (fzf only puts stdin/stdout on
# the tty) — so point it at the terminal explicitly.
fetch() {
  local url="$1" dest="$2" title="$3" tmp ok=1
  tmp=$(mktemp -- "$dest.XXXXXX")
  local -a curl_cmd=(curl -fsSL --connect-timeout 10 --max-time 120
    --max-redirs 3 --max-filesize 67108864 -o "$tmp" "$url")
  # Pin https downloads to https, redirects included (file:// stays usable
  # for the tests).
  if [[ $url == https://* ]]; then
    curl_cmd+=(--proto '=https' --proto-redir '=https')
  fi
  if [[ -t 1 ]] && : 2>/dev/null <>/dev/tty && command -v gum >/dev/null; then
    gum spin --title "$title" -- "${curl_cmd[@]}" 2>/dev/tty || ok=0
  else
    "${curl_cmd[@]}" || ok=0
  fi
  if (( ok )) && jq -e '.plugins' "$tmp" >/dev/null 2>&1; then
    mv -f -- "$tmp" "$dest"
    return 0
  fi
  rm -f -- "$tmp"
  return 1
}

# Flatten catalog + stats into a TSV that sort/awk can chew through in
# milliseconds, plus one-JSON-per-line index for the preview lookup.
#
# rows.tsv columns:
#  1 id  2 name  3 author  4 tags  5 category  6 kind  7 stars  8 hearts
#  9 views  10 copies  11 addedAt  12 updatedAt  13 verified  14 installAvailable
#  15 repo  16 sourceType
flatten_cache() {
  local stats="$CACHE_DIR/stats.json" tmp
  [[ -f $stats ]] || stats=/dev/null

  # Entries whose id is not a plain token are dropped from both files, and
  # every string is stripped of C0/C1 control characters (\x{..} form: the
  # plain \x7f-\x9f range does not reach C1 code points in jq's regex engine).
  local id_select='select((.id|type)=="string" and (.id|test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and ((.id|contains(".."))|not))'
  tmp=$(mktemp -- "$CACHE_DIR/rows.XXXXXX")
  jq -r --slurpfile st "$stats" '
    def clean: (. // "") | tostring | gsub("[\\x{00}-\\x{1f}\\x{7f}-\\x{9f}]"; " ");
    ($st[0].plugins // {}) as $s
    | .plugins[]
    | '"$id_select"'
    | . as $p | ($s[$p.id] // {}) as $m
    | [ ($p.id | clean), ($p.name | clean), ($p.author | clean),
        (($p.tags // []) | join(",") | clean),
        ($p.category | clean), ($p.kind | clean),
        ($p.stars // 0 | tonumber? // 0), ($m.hearts? // 0 | tonumber? // 0),
        ($m.views? // 0 | tonumber? // 0), ($m.copies? // 0 | tonumber? // 0),
        (($p.addedAt // "0000-00-00") | clean), ($p.repositoryUpdatedAt | clean),
        (if $p.verificationStatus == "verified" then 1 else 0 end),
        (if $p.installAvailable == true then 1 else 0 end),
        ($p.repo | clean), (($p.sourceType // "community") | clean)
      ] | @tsv
  ' "$CACHE_DIR/catalog.json" >"$tmp"
  mv -f -- "$tmp" "$CACHE_DIR/rows.tsv"

  tmp=$(mktemp -- "$CACHE_DIR/index.XXXXXX")
  jq -c --slurpfile st "$stats" '
    ($st[0].plugins // {}) as $s
    | .plugins[]
    | '"$id_select"'
    | {id} + . + {stats: ($s[.id] // {})}
    | del(.previewImage, .previewThumbnail, .previewWidth, .previewHeight,
          .previewThumbnailWidth, .previewThumbnailHeight,
          .previewSourceWidth, .previewSourceHeight, .accent, .initials)
  ' "$CACHE_DIR/catalog.json" >"$tmp"
  mv -f -- "$tmp" "$CACHE_DIR/index.ndjson"

  cut -f5 "$CACHE_DIR/rows.tsv" | grep -v '^$' | sort -u >"$CACHE_DIR/categories.txt"
}

ensure_cache() {
  local force=0 offline=0
  [[ ${1-} == --force ]] && force=1
  mkdir -p "$CACHE_DIR"

  if (( force )) || ! cache_fresh catalog.json "$CATALOG_TTL_MIN"; then
    fetch "$CATALOG_URL" "$CACHE_DIR/catalog.json" "Downloading plugin catalog (7 MB)…" || offline=1
  fi
  if (( force )) || ! cache_fresh stats.json "$STATS_TTL_MIN"; then
    fetch "$STATS_URL" "$CACHE_DIR/stats.json" "Downloading plugin stats…" || offline=1
  fi

  if (( offline )); then
    touch "$CACHE_DIR/.offline"
  else
    rm -f "$CACHE_DIR/.offline"
  fi

  [[ -f $CACHE_DIR/catalog.json ]] ||
    fail "could not download $CATALOG_URL and no cached copy exists"

  if [[ ! -f $CACHE_DIR/rows.tsv ||
        $CACHE_DIR/rows.tsv -ot $CACHE_DIR/catalog.json ||
        ( -f $CACHE_DIR/stats.json && $CACHE_DIR/rows.tsv -ot $CACHE_DIR/stats.json ) ]]; then
    flatten_cache
  fi
}

# id \t enabled(true|false|?) for every installed plugin. Asks the live shell
# (covers first-party builtins too); falls back to a directory scan if the
# shell is not running.
installed_tsv() {
  local tmp m id
  tmp=$(mktemp -- "$CACHE_DIR/installed.XXXXXX")
  if ! omarchy-plugin-list --json 2>/dev/null |
    jq -r --arg re "$ID_RE" '.[] | select((.id | type) == "string" and (.id | test($re)))
      | [.id, (.enabled | tostring)] | @tsv' >"$tmp" 2>/dev/null || [[ ! -s $tmp ]]; then
    : >"$tmp"
    for m in "$PLUGINS_DIR"/*/manifest.json; do
      [[ -f $m ]] || continue
      id=$(jq -r '.id // empty' "$m" 2>/dev/null) || continue
      valid_id "$id" || continue
      printf '%s\t?\n' "$id"
    done >"$tmp" || true
  fi
  mv -f -- "$tmp" "$CACHE_DIR/installed.tsv"
}

installed_state() {
  awk -F '\t' -v id="$1" '$1 == id { print $2; exit }' "$CACHE_DIR/installed.tsv" 2>/dev/null || true
}

# The index line whose record starts with {"id":"<id>", — anchored at column
# 1, so a crafted record embedding another plugin's id further along the line
# cannot shadow the real one. Prints nothing for an unknown id; fails for an
# id that is not even well-formed.
record_for() {
  valid_id "$1" || return 1
  awk -v p="{\"id\":\"$1\"," 'index($0, p) == 1 { print; exit }' "$CACHE_DIR/index.ndjson" 2>/dev/null || return 1
}

# ---------------------------------------------------------------- state ---

# The state file is plain KEY=value lines (one per key, no quoting). It is
# parsed, never sourced: only the six known keys are read and each value has
# to be well-formed, so a stray file in the state dir cannot run code.
load_state() {
  [[ -f $STATE_FILE ]] || return 0
  local line key value
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^(SORT|CATEGORY|ONLY_INSTALLED|ONLY_VERIFIED|HL_FIELD|HL_UNTIL)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    case $key in
    SORT)
      if [[ " ${SORTS[*]} " == *" $value "* ]]; then SORT=$value; fi ;;
    CATEGORY)
      CATEGORY=$(sanitize "$value") ;;   # a category name from the catalog, or empty for "all"
    ONLY_INSTALLED | ONLY_VERIFIED)
      if [[ $value == [01] ]]; then printf -v "$key" '%s' "$value"; fi ;;
    HL_FIELD)
      if [[ $value =~ ^(SORT|CATEGORY|ONLY_INSTALLED|ONLY_VERIFIED)?$ ]]; then HL_FIELD=$value; fi ;;
    HL_UNTIL)
      if [[ $value =~ ^[0-9]+$ ]]; then HL_UNTIL=$value; fi ;;
    esac
  done <"$STATE_FILE"
  return 0
}

save_state() {
  local tmp
  mkdir -p "$(dirname -- "$STATE_FILE")"
  tmp=$(mktemp -- "$STATE_FILE.XXXXXX")
  printf 'SORT=%s\nCATEGORY=%s\nONLY_INSTALLED=%s\nONLY_VERIFIED=%s\nHL_FIELD=%s\nHL_UNTIL=%s\n' \
    "$SORT" "$CATEGORY" "$ONLY_INSTALLED" "$ONLY_VERIFIED" "$HL_FIELD" "$HL_UNTIL" >"$tmp"
  mv -f -- "$tmp" "$STATE_FILE"
}

# Print the fzf action string that re-reads rows and header after a state change.
refresh_actions() {
  echo 'reload("$OPT_SELF" __rows)+transform-header("$OPT_SELF" __header)'
}

now_ms() { date +%s%3N; }

# Remember which header field just changed so render_header shows it in
# reverse video for HL_MS, then arrange for the highlight to be cleared.
mark_changed() {
  HL_FIELD=$1
  HL_UNTIL=$(( $(now_ms) + HL_MS ))
}

# fzf runs with --listen on a unix socket inside the private state dir and
# exports its path as FZF_SOCK to its children. Fork a fully detached sleeper
# (own session, no fds shared with fzf, so the transform that called us
# returns immediately) that pushes a fresh header once the deadline has
# passed. Headless callers have no FZF_SOCK: skip.
schedule_unhighlight() {
  [[ -n ${FZF_SOCK-} ]] || return 0
  setsid -f "$SELF" __unhighlight </dev/null >/dev/null 2>&1 || true
}

# Body of the detached sleeper. render_header re-checks HL_UNTIL, so if the
# user pressed the key again meanwhile the header we push is still
# highlighted and the later sleeper clears it. The safe --listen server only
# accepts plain-text actions, hence the header is computed here and sent as
# change-header:<text> (colon form, because the text contains parentheses).
# Requests carry the per-run FZF_API_KEY that main() generated.
unhighlight() {
  sleep 1.3
  local header
  header=$(render_header)
  [[ -n ${FZF_SOCK-} && -n ${FZF_API_KEY-} ]] || return 0
  curl -s -m 3 -o /dev/null --unix-socket "$FZF_SOCK" -H "x-api-key: $FZF_API_KEY" \
    -XPOST http://localhost/ --data-binary "change-header:$header" || true
}

cycle() {
  # cycle <current> <next|prev> <values...> → prints the new value
  local current="$1" direction="$2"; shift 2
  local -a values=("$@")
  local i n=${#values[@]}
  for (( i = 0; i < n; i++ )); do
    [[ ${values[i]} == "$current" ]] && break
  done
  (( i == n )) && i=0
  if [[ $direction == prev ]]; then
    i=$(( (i - 1 + n) % n ))
  else
    i=$(( (i + 1) % n ))
  fi
  printf '%s\n' "${values[i]}"
}

set_state() {
  local key="$1" value="$2"
  load_state
  case $key in
  SORT)
    case $value in
    next | prev) SORT=$(cycle "$SORT" "$value" "${SORTS[@]}") ;;
    *)
      [[ " ${SORTS[*]} " == *" $value "* ]] || fail "unknown sort: $value"
      SORT=$value
      ;;
    esac
    ;;
  CATEGORY)
    local -a cats=("")
    mapfile -t -O 1 cats <"$CACHE_DIR/categories.txt"
    case $value in
    next | prev) CATEGORY=$(cycle "$CATEGORY" "$value" "${cats[@]}") ;;
    All | all) CATEGORY="" ;;
    *) CATEGORY=$value ;;
    esac
    ;;
  *) fail "unknown state key: $key" ;;
  esac
  mark_changed "$key"
  save_state
  schedule_unhighlight
}

toggle_state() {
  load_state
  case $1 in
  ONLY_INSTALLED) ONLY_INSTALLED=$(( ONLY_INSTALLED ? 0 : 1 )) ;;
  ONLY_VERIFIED) ONLY_VERIFIED=$(( ONLY_VERIFIED ? 0 : 1 )) ;;
  *) fail "unknown toggle: $1" ;;
  esac
  mark_changed "$1"
  save_state
  schedule_unhighlight
}

# Interactive pickers (run inside fzf's execute(), so they own the tty).
pick_state() {
  load_state
  local choice
  case $1 in
  CATEGORY)
    choice=$({ echo All; cat "$CACHE_DIR/categories.txt"; } |
      gum choose --header="Filter by category" --selected="${CATEGORY:-All}") || return 0
    [[ -n $choice ]] && set_state CATEGORY "$choice"
    ;;
  SORT)
    choice=$(printf '%s\n' "${SORTS[@]}" |
      gum choose --header="Sort by" --selected="$SORT") || return 0
    [[ -n $choice ]] && set_state SORT "$choice"
    ;;
  esac
}

# ---------------------------------------------------------------- rows ---

age_of() {
  local file="$CACHE_DIR/$1" secs
  [[ -f $file ]] || { echo "none"; return; }
  secs=$(( $(date +%s) - $(stat -c %Y "$file") ))
  if (( secs < 60 )); then echo "${secs}s"
  elif (( secs < 3600 )); then echo "$(( secs / 60 ))m"
  elif (( secs < 86400 )); then echo "$(( secs / 3600 ))h"
  else echo "$(( secs / 86400 ))d"
  fi
}

# hl_field <FIELD> <value>: the value padded by one space on each side, in
# bold reverse video while FIELD is the one that just changed (fzf renders
# ANSI in the header without --ansi). Same width either way, so nothing shifts.
hl_field() {
  if [[ $1 == "$HL_ACTIVE" ]]; then
    printf '\e[1;7m %s \e[0m' "$2"
  else
    printf ' %s ' "$2"
  fi
}

render_header() {
  load_state
  local status=""
  HL_ACTIVE=""
  [[ -f $CACHE_DIR/.offline ]] && status="  [offline — showing stale cache]"
  if [[ -n $HL_FIELD && $HL_UNTIL =~ ^[0-9]+$ ]] && (( $(now_ms) < HL_UNTIL )); then
    HL_ACTIVE=$HL_FIELD
  fi
  printf 'sort:%s▾   category:%s   installed-only:%s   verified-only:%s   catalog: %s ago (stats %s)%s\n' \
    "$(hl_field SORT "$SORT")" \
    "$(hl_field CATEGORY "${CATEGORY:-all}")" \
    "$(hl_field ONLY_INSTALLED "$( (( ONLY_INSTALLED )) && echo on || echo off)")" \
    "$(hl_field ONLY_VERIFIED "$( (( ONLY_VERIFIED )) && echo on || echo off)")" \
    "$(age_of catalog.json)" "$(age_of stats.json)" "$status"
  printf 'enter install  ctrl-t enable/disable  ctrl-x remove  ctrl-o update  ctrl-r refresh   alt-s sort  alt-c category  alt-i/v filters  ? help  esc quit\n'
}

build_rows() {
  load_state
  installed_tsv
  local -a sk
  case $SORT in
  stars)   sk=(-k7,7nr -k2,2f) ;;
  hearts)  sk=(-k8,8nr -k2,2f) ;;
  views)   sk=(-k9,9nr -k2,2f) ;;
  copies)  sk=(-k10,10nr -k2,2f) ;;
  added)   sk=(-k11,11r -k2,2f) ;;
  updated) sk=(-k12,12r -k2,2f) ;;
  name)    sk=(-k2,2f) ;;
  *)       sk=(-k7,7nr -k2,2f) ;;
  esac

  LC_ALL=C.UTF-8 sort -t $'\t' "${sk[@]}" "$CACHE_DIR/rows.tsv" |
    LC_ALL=C.UTF-8 awk -F '\t' -v OFS='\t' \
      -v cat="$CATEGORY" -v oi="$ONLY_INSTALLED" -v ov="$ONLY_VERIFIED" \
      -v g_star="$G_STAR" -v g_heart="$G_HEART" -v g_views="$G_VIEWS" -v g_copies="$G_COPIES" '
      FILENAME == ARGV[1] { inst[$1] = $2; next }
      cat != "" && $5 != cat { next }
      oi == 1 && !($1 in inst) { next }
      ov == 1 && $13 != 1 { next }
      {
        mark = ($1 in inst) ? (inst[$1] == "true" ? "●" : "○") : " "
        disp = sprintf("%s %-30.30s %-14.14s %-10.10s %s%5s %s%4s %s%6s %s%5s",
          mark, $2, $5, $6, g_star, $7, g_heart, $8, g_views, $9, g_copies, $10)
        print $1, disp, $2, $3, $4
      }' "$CACHE_DIR/installed.tsv" -
}

# ---------------------------------------------------------------- preview ---

# Every catalog string goes through clean (control characters → space) before
# it is printed, and every number through tonumber, so the record cannot
# smuggle escape sequences into the preview pane.
render_preview() {
  local id="$1" rec inst cols="${FZF_PREVIEW_COLUMNS:-80}"
  rec=$(record_for "$id") || rec=""
  [[ -n $rec ]] || { echo "No catalog record for $(sanitize "$id")"; return 0; }
  inst=$(installed_state "$id")

  jq -r --arg inst "$inst" '
    def clean: (. // "") | tostring | gsub("[\\x{00}-\\x{1f}\\x{7f}-\\x{9f}]"; " ");
    def pad($n): . + (" " * ([$n - length, 0] | max));
    def row($k; $v): "[1m\($k | pad(10))[0m " + (($v // "-") | clean);
    def rawrow($k; $v): "[1m\($k | pad(10))[0m " + $v;   # $v built here from cleaned parts only
    def n(x): ((x // 0) | tonumber? // 0) | tostring;
    "[1;32m\(.name | clean)[0m  [2m\(.id | clean)[0m",
    (if $inst == "true" then "[32m● enabled[0m"
     elif $inst == "false" then "[33m○ installed (disabled)[0m"
     elif $inst == "?" then "[33m○ installed[0m"
     else "[2m  not installed[0m" end),
    "",
    row("Author"; .author),
    row("Version"; .version),
    row("Category"; .category),
    row("Kind"; .kind),
    row("Tags"; ((.tags // []) | if type == "array" then map(clean) | join(", ") else clean end)),
    rawrow("Stats"; "[33m'"$G_STAR"'[0m \(n(.stars))   [31m'"$G_HEART"'[0m \(n(.stats.hearts?))   '"$G_VIEWS"' \(n(.stats.views?))   '"$G_COPIES"' \(n(.stats.copies?))"),
    row("Verified"; ((.verificationStatus // (if .sourceType == "builtin" then "built-in" else "unknown" end)) | clean)
                    + (if .verificationMethod then " (\(.verificationMethod | clean))" else "" end)),
    row("Status"; .status),
    row("License"; .license),
    row("Repo"; .repo),
    row("Added"; .addedAt),
    row("Updated"; ((.repositoryUpdatedAt // "") | clean | .[0:10])),
    row("Release"; (.repositoryRelease.tag? // "-")),
    "",
    ((.description // "") | clean),
    "",
    row("Install"; (if (.installCommand // "") == "" then "not installable (\((.status // "unknown") | clean))" else .installCommand end)),
    (if (.installNote // "") != "" then "[33mNote:[0m \(.installNote | clean)" else empty end)
  ' <<<"$rec" | fold -s -w "$cols"
}

# ---------------------------------------------------------------- actions ---

run_cmd() {
  if (( DRY_RUN )); then
    echo "[dry-run] $(sanitize "$*")"
    return 0
  fi
  echo "→ $(sanitize "$*")"
  "$@"
}

yes_flag() {
  (( ASSUME_YES )) && echo --yes
  return 0
}

# Only plain GitHub repository URLs are handed to `omarchy plugin add`; the
# catalog's installCommand / repo fields are data, not a command line.
INSTALL_URL_RE='^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(\.git)?/?$'

do_install() {
  local id="$1" rec source_type avail repo status note cmd_url url
  local sid; sid=$(sanitize "$id")
  rec=$(record_for "$id") || rec=""
  [[ -n $rec ]] || { echo "$sid: not in catalog"; return 1; }
  IFS=$'\t' read -r source_type avail repo status note cmd_url < <(
    jq -r '
      def clean: (. // "") | tostring | gsub("[\\x{00}-\\x{1f}\\x{7f}-\\x{9f}]"; " ");
      [ (.sourceType // "community" | clean), (.installAvailable | tostring), (.repo | clean),
        (.status | clean), (.installNote | clean),
        ((.installCommand // "") | tostring | capture("^omarchy plugin add (?<u>[^ ]+)")?.u // "" | clean) ] | @tsv' <<<"$rec")

  if [[ -n $(installed_state "$id") ]]; then
    echo "$sid: already installed — use ctrl-o to update or ctrl-t to enable/disable"
    return 0
  fi
  if [[ $source_type == builtin ]]; then
    echo "$sid: built into Omarchy — use ctrl-t to enable/disable it"
    return 0
  fi
  if [[ $avail != true || ( -z $repo && -z $cmd_url ) ]]; then
    echo "$sid: not installable ($(sanitize "${status:-unknown}"))"
    [[ -n $note ]] && echo "  $(sanitize "$note")"
    return 0
  fi
  url=${cmd_url:-$repo}
  if [[ ! $url =~ $INSTALL_URL_RE ]]; then
    echo "$sid: refusing unexpected install URL: $(sanitize "$url")"
    return 1
  fi
  omarchy-git-url-check "$url" || return 1
  # shellcheck disable=SC2046
  run_cmd omarchy-plugin-add "$url" --enable $(yes_flag)
}

do_remove() {
  local id="$1"
  [[ -n $(installed_state "$id") ]] || { echo "$(sanitize "$id"): not installed"; return 0; }
  [[ -d $PLUGINS_DIR/$id || -L $PLUGINS_DIR/$id ]] ||
    { echo "$(sanitize "$id"): built into Omarchy — it cannot be removed, only disabled (ctrl-t)"; return 0; }
  # shellcheck disable=SC2046
  run_cmd omarchy-plugin-remove "$id" $(yes_flag)
}

do_toggle_enable() {
  local id="$1" state
  state=$(installed_state "$id")
  case $state in
  "") echo "$(sanitize "$id"): not installed — press enter to install it" ;;
  true) run_cmd omarchy-plugin-disable "$id" ;;
  *) run_cmd omarchy-plugin-enable "$id" ;;
  esac
}

do_update() {
  local id="$1"
  [[ -n $(installed_state "$id") ]] || { echo "$(sanitize "$id"): not installed"; return 0; }
  [[ -d $PLUGINS_DIR/$id/.git ]] ||
    { echo "$(sanitize "$id"): not a git-managed plugin, nothing to update"; return 0; }
  # shellcheck disable=SC2046
  run_cmd omarchy-plugin-update "$id" $(yes_flag)
}

run_action() {
  local verb="$1" id
  shift
  (( $# )) || return 0
  for id in "$@"; do
    echo
    if ! valid_id "$id"; then
      echo "$(sanitize "$id"): not a valid plugin id"
      continue
    fi
    case $verb in
    install) do_install "$id" ;;
    remove) do_remove "$id" ;;
    toggle-enable) do_toggle_enable "$id" ;;
    update) do_update "$id" ;;
    esac || echo "$(sanitize "$id"): $verb failed"
  done
  omarchy-show-done
  drain_tty
}

open_repo() {
  local repo
  repo=$(record_for "$1" | jq -r '.repo // empty') || repo=""
  repo=$(sanitize "$repo")
  [[ $repo =~ ^https?:// ]] || return 0
  setsid -f xdg-open "$repo" >/dev/null 2>&1
}

help_text() {
  local b=$'\e[1m' n=$'\e[0m'
  cat <<HELP

 ${b}Search${n}
   type            fuzzy search over name, id, author and tags
   tab             multi-select

 ${b}Navigation — alt${n}
   home / end      jump to the top / bottom of the list
   alt-s / alt-S   cycle sort / pick sort from a list
                   (stars → hearts → views → copies → added → updated → name)
   alt-c / alt-C   cycle category / pick category from a list
   alt-i           toggle installed-only
   alt-v           toggle verified-only
   alt-p           toggle the details pane
   alt-j / alt-k   scroll the details pane one line
   alt-d / alt-u   scroll the details pane half a page
   alt-o           open the plugin repository in the browser

 ${b}Actions — ctrl${n}
   enter           install selected plugin(s)   → omarchy plugin add <repo> --enable
   ctrl-t          enable / disable an installed plugin
   ctrl-x          remove an installed plugin
   ctrl-o          update an installed plugin
   ctrl-r          re-download catalog and stats

 ${b}Help & quit${n}
   alt-h or ?      this help
   esc or ctrl-q   quit

 ● enabled   ○ installed but disabled
 Cache: $CACHE_DIR
HELP
}

# Runs inside fzf's execute(), so it owns the tty: a read-only nested fzf
# drawn as a bordered popup over the list. Any of esc/q/enter/?/alt-h/ctrl-q
# closes it.
show_help() {
  help_text | fzf --ansi --no-input --no-multi --layout=reverse --no-info --no-scrollbar \
    --pointer=' ' --margin=3%,8% --border=rounded \
    --border-label=' Keys — press esc to close this help ' \
    --color='fg+:-1,bg+:-1,gutter:-1' \
    --bind 'esc:abort,q:abort,enter:abort,?:abort,alt-h:abort,ctrl-q:abort' >/dev/null || true
}

# ---------------------------------------------------------------- main ---

fzf_main() {
  local title
  title=$(title)
  # Same string in the terminal's window title as in the top-left border label.
  printf '\e]2;%s\a' "$title"
  local -a fzf_args=(
    --multi
    --delimiter $'\t'
    --with-nth 2
    --nth 1..5
    --accept-nth 1
    --tiebreak index
    --header "$(render_header)"
    --prompt 'plugins> '
    --border top
    --border-label " $title "
    --border-label-pos 2
    --preview '"$OPT_SELF" __preview {1}'
    --preview-window 'down:65%:wrap'
    --preview-label 'alt-p: toggle preview, alt-j/k: scroll, tab: multi-select, ?: help'
    --preview-label-pos 'bottom'
    # Action endpoint on a unix socket inside the private state dir (exported
    # as FZF_SOCK to child processes, requests authenticated with the per-run
    # FZF_API_KEY) so the detached sleeper in schedule_unhighlight can push a
    # fresh header after the highlight deadline without blocking the UI. No
    # TCP port is opened.
    --listen "$state_dir/fzf.sock"
    # esc and ctrl-q quit: neutralise fzf's other default abort keys, and make
    # ctrl-d a plain delete-char (its default aborts on an empty query).
    --bind 'ctrl-c:ignore,ctrl-g:ignore,ctrl-q:abort,ctrl-d:delete-char'
    # Default (bottom-up) layout: item #1 sits next to the prompt at the
    # bottom, so the visually top row is `last` and the bottom row `first`.
    --bind 'home:last,end:first'
    # navigation: alt
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --bind 'alt-s:transform("$OPT_SELF" __set SORT next)'
    --bind 'alt-S:execute("$OPT_SELF" __pick SORT)+transform("$OPT_SELF" __refresh)'
    --bind 'alt-c:transform("$OPT_SELF" __set CATEGORY next)'
    --bind 'alt-C:execute("$OPT_SELF" __pick CATEGORY)+transform("$OPT_SELF" __refresh)'
    --bind 'alt-i:transform("$OPT_SELF" __toggle ONLY_INSTALLED)'
    --bind 'alt-v:transform("$OPT_SELF" __toggle ONLY_VERIFIED)'
    --bind 'alt-o:execute-silent("$OPT_SELF" __open {1})'
    --bind 'alt-h:execute("$OPT_SELF" __help)+transform-header("$OPT_SELF" __header)'
    --bind '?:execute("$OPT_SELF" __help)+transform-header("$OPT_SELF" __header)'
    # actions: ctrl (and enter)
    --bind 'ctrl-r:execute("$OPT_SELF" __refresh-cache)+transform("$OPT_SELF" __refresh)'
    --bind 'enter:execute("$OPT_SELF" __install {+1})+deselect-all+reload("$OPT_SELF" __rows)'
    --bind 'ctrl-x:execute("$OPT_SELF" __remove {+1})+deselect-all+reload("$OPT_SELF" __rows)'
    --bind 'ctrl-t:execute("$OPT_SELF" __toggle-enable {+1})+deselect-all+reload("$OPT_SELF" __rows)'
    --bind 'ctrl-o:execute("$OPT_SELF" __update {+1})+deselect-all+reload("$OPT_SELF" __rows)'
    --color 'pointer:green,marker:green'
  )
  build_rows | SHELL=/bin/bash fzf "${fzf_args[@]}" >/dev/null || true
}

main() {
  local force=""
  while (( $# > 0 )); do
    case "$1" in
    --refresh) force=--force ;;
    --yes | -y) ASSUME_YES=1 ;;
    --dry-run) DRY_RUN=1 ;;
    -h | --help) usage; exit 0 ;;
    *) fail "unknown option: $1" ;;
    esac
    shift
  done

  # Launched from a .desktop entry or app launcher without a terminal.
  if [[ ! -t 0 || ! -t 1 ]]; then
    # TUI.float is the app-id Omarchy's own TUI launchers use: Hyprland floats
    # and centres it at 875x600 (default/hypr/apps/system.lua).
    if command -v omarchy-launch-tui >/dev/null; then
      exec omarchy-launch-tui --app-id=TUI.float "$SELF" "$@"
    fi
    exec xdg-terminal-exec --app-id=TUI.float -e "$SELF" "$@"
  fi

  local dep
  for dep in fzf jq curl gum; do
    command -v "$dep" >/dev/null || fail "$dep is required"
  done

  ensure_cache $force
  drain_tty

  # Private (0700) per-run state dir: the state file and fzf's unix socket.
  state_dir=$(mktemp -d -- "${XDG_RUNTIME_DIR:-/tmp}/oma-quick-plugin-tui.XXXXXX")
  trap 'rm -rf -- "$state_dir"' EXIT
  export OPT_SELF="$SELF" OPT_STATE="$state_dir/state" OPT_STATE_DIR="$state_dir"
  export OMA_QUICK_PLUGIN_TUI_DRY_RUN="$DRY_RUN" OMA_QUICK_PLUGIN_TUI_YES="$ASSUME_YES"
  # fzf's --listen server requires this key on every request.
  FZF_API_KEY=$(head -c 32 /dev/urandom | base64)
  export FZF_API_KEY
  STATE_FILE="$OPT_STATE"
  save_state

  fzf_main
}

case "${1-}" in
"" | -* )        main "$@" ;;
__rows)          build_rows ;;
__preview)       render_preview "${2:?plugin id}" ;;
__header)        render_header ;;
__set)           set_state "${2:?key}" "${3:?value}"; refresh_actions ;;
__toggle)        toggle_state "${2:?key}"; refresh_actions ;;
__pick)          pick_state "${2:?key}"; drain_tty ;;
__refresh)       refresh_actions ;;
__refresh-cache) ensure_cache --force; drain_tty ;;
__install)       run_action install "${@:2}" ;;
__remove)        run_action remove "${@:2}" ;;
__toggle-enable) run_action toggle-enable "${@:2}" ;;
__update)        run_action update "${@:2}" ;;
__open)          open_repo "${2:?plugin id}" ;;
__help)          show_help; drain_tty ;;
__unhighlight)   unhighlight ;;
*)               fail "unknown subcommand: $1" ;;
esac
