[Desktop Entry]
Type=Application
Version=1.0
Name=Fast Plugin TUI for Omarchy
GenericName=Omarchy Plugin Browser
Comment=Browse, search, sort and install Omarchy plugins
Exec=omarchy-launch-tui --app-id=TUI.float "@PLUGIN_DIR@/bin/fast-plugin-tui-omarchy"
Icon=system-software-install
Terminal=false
Categories=Settings;PackageManager;
Keywords=Omarchy;Plugin;Extension;Marketplace;
StartupNotify=false
X-Fast-Plugin-TUI-Omarchy-Managed=true
